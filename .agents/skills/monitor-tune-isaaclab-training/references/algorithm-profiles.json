{
  "schema_version": 1,
  "profiles": [
    {
      "id": "generic",
      "profile_version": 2,
      "is_generic": true,
      "match": {
        "backends": ["*"],
        "algorithm_names": ["*"],
        "runner_classes": ["*"]
      },
      "progress_patterns": [
        {
          "name": "learning_iteration",
          "regex": "Learning iteration\\s+(?P<current>\\d+)(?:/(?P<target>\\d+))?",
          "completion_offset": 1
        },
        {
          "name": "epoch",
          "regex": "(?:Epoch|epoch)\\s*[: ]\\s*(?P<current>\\d+)(?:/(?P<target>\\d+))?",
          "completion_offset": 0
        },
        {
          "name": "global_step",
          "regex": "(?:global_step|Global step|Step)\\s*[: ]\\s*(?P<current>\\d+)(?:/(?P<target>\\d+))?",
          "completion_offset": 0
        }
      ],
      "metric_aliases": {
        "Mean reward": "mean_reward",
        "Mean episode length": "mean_episode_length",
        "Total timesteps": "total_timesteps",
        "Iteration time": "iteration_time_seconds"
      },
      "protected_parameter_patterns": [
        "(?:^|\\.)(?:batch_size|num_updates|update_count|num_learning_epochs|num_mini_batches)(?:$|\\.)"
      ],
      "resume_required_args": [],
      "evaluation_capabilities": {
        "play_entrypoint": null,
        "supported_artifacts": ["native"],
        "history_contract": "review_required"
      }
    },
    {
      "id": "rsl-rl-generic",
      "profile_version": 2,
      "is_generic": true,
      "extends": "generic",
      "match": {
        "backends": ["rsl_rl"],
        "algorithm_names": ["*"],
        "runner_classes": ["*"]
      },
      "metric_aliases": {
        "Mean action noise std": "action_noise_std",
        "Mean value_function loss": "value_function_loss",
        "Mean surrogate loss": "surrogate_loss",
        "Mean entropy loss": "entropy_loss",
        "Metrics/base_velocity/error_vel_xy": "error_vel_xy",
        "Metrics/base_velocity/error_vel_yaw": "error_vel_yaw",
        "Episode_Termination/time_out": "time_out",
        "Episode_Termination/terrain_out_of_bounds": "terrain_out_of_bounds",
        "Episode_Termination/illegal_contact": "illegal_contact"
      },
      "resume_required_args": ["--resume"],
      "evaluation_capabilities": {
        "play_entrypoint": "scripts/reinforcement_learning/rsl_rl/play.py",
        "supported_artifacts": ["native"],
        "history_contract": "review_required"
      }
    },
    {
      "id": "rsl-rl-ppo",
      "profile_version": 2,
      "is_generic": false,
      "extends": "rsl-rl-generic",
      "match": {
        "backends": ["rsl_rl"],
        "algorithm_names": ["PPO"],
        "runner_classes": ["OnPolicyRunner"]
      },
      "evaluation_capabilities": {
        "play_entrypoint": "scripts/reinforcement_learning/rsl_rl/play.py",
        "supported_artifacts": ["native", "jit", "onnx"],
        "history_contract": "current_observation"
      }
    },
    {
      "id": "rsl-rl-distillation",
      "profile_version": 2,
